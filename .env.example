# Copy to .env (never commit .env). Use a LOCAL/DEVELOPMENT database only.
NODE_ENV=development

# PostgreSQL connection string for the dev database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tapasok_dev?schema=public

# Absolute session lifetime in hours (default 8)
SESSION_MAX_AGE_HOURS=8

# Optional: password for demo accounts created by `npm run db:seed` (generated and printed if unset)
# SEED_PASSWORD=

# Separate database used ONLY by `npm test` (tables are truncated between tests).
# The name must end in _test. Create it once: CREATE DATABASE tapasok_test OWNER <your dev role>;
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tapasok_test?schema=public

# Secret used to sign members' rotating attendance QR codes. 32+ random characters; never commit the real one.
QR_SECRET=replace_with_a_long_random_secret

# Where uploaded documents are stored on disk (outside public/). Defaults to ./storage
STORAGE_DIR=./storage

# Public address of the app, encoded in event check-in QR codes so phones open the right page.
APP_URL=http://localhost:3000
