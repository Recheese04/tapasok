{
  "expo": {
    "name": "Tapasok",
    "slug": "tapasok-mobile",
    "version": "1.0.0",
    "scheme": "tapasok",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ph.edu.bisu.tapasok"
    },
    "android": {
      "package": "ph.edu.bisu.tapasok"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Tapasok uses the camera only to scan an event's attendance QR code.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
