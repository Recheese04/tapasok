// Tapasok database schema (new database; no legacy schema is being mirrored).
// Increment 1: authentication, users, organizations, organization membership, audit log.
// Later modules (events, attendance, consequences, evaluations, fees, ...) get their own migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  SYSTEM_ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
  INVITED // created without a password; must complete account setup
}

enum OrganizationStatus {
  ACTIVE
  ARCHIVED
}

// Role a person holds inside one organization.
enum OrganizationRole {
  PRESIDENT
  TREASURER
  OFFICER
  ADVISER
  MEMBER
  SECRETARY
  AUDITOR
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique // stored lowercase; normalized in application code
  passwordHash       String     @map("password_hash")
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  studentNumber      String?    @unique @map("student_number")
  systemRole         SystemRole @default(USER) @map("system_role")
  status             UserStatus @default(ACTIVE)
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  // Set when the account was given the shared default password: the person must choose their own before using Tapasok.
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions            Session[]
  memberships         OrganizationMember[]
  auditLogs           AuditLog[]
  createdJoinCodes    OrganizationJoinCode[]
  studentProfile      StudentProfile?
  staffProfile        StaffProfile?
  photo               ProfilePhoto?
  activationTokens    ActivationToken[]
  attendance          AttendanceRecord[]
  consequences        Consequence[]
  obligations         Obligation[]
  evaluationResponses EvaluationResponse[]
  fees                StudentFee[]
  announcements       Announcement[]
  enrollments         StudentEnrollment[]
  rfidEnrollments     RfidEnrollment[]
  fundsRecorded       FundTransaction[]      @relation("FundRecordedBy")
  fundsDecided        FundTransaction[]      @relation("FundDecidedBy")
  financialAudit      FinancialAuditEntry[]  @relation("FinancialAuditActor")
  joinRequests        JoinRequest[]          @relation("JoinRequestUser")
  decidedRequests     JoinRequest[]          @relation("JoinRequestDecider")
  notifications       Notification[]
  siteFeedback        SiteFeedback[]
  clearanceRequests   ClearanceRequest[]
  clearanceSignoffs   ClearanceSignoff[]

  @@map("users")
}

// Server-side sessions. The browser holds a random token; only its SHA-256 hash is stored.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Organization {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @unique
  acronym           String?
  description       String?
  status            OrganizationStatus @default(ACTIVE)
  scope             OrganizationScope  @default(CO_CURRICULAR)
  collegeId         String?            @map("college_id") @db.Uuid
  departmentId      String?            @map("department_id") @db.Uuid
  programId         String?            @map("program_id") @db.Uuid
  autoEnroll        Boolean            @default(false) @map("auto_enroll") // explicit opt-in to academic-unit mapping
  college           College?           @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  department        Department?        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  program           Program?           @relation(fields: [programId], references: [id], onDelete: Restrict)
  joinRequests      JoinRequest[]
  devices           ScannerDevice[]
  feeAssessments    StudentFee[]
  clearanceRequests ClearanceRequest[]
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  members          OrganizationMember[]
  joinCodes        OrganizationJoinCode[]
  events           Event[]
  announcements    Announcement[]
  documents        Document[]
  consequenceRules ConsequenceRule[]
  consequences     Consequence[]
  obligations      Obligation[]
  evaluationForms  EvaluationForm[]
  feeTypes         FeeType[]
  fundTransactions FundTransaction[]
  financialAudit   FinancialAuditEntry[]

  @@map("organizations")
}

// One row per period a person holds a role in an organization.
// Ending a membership sets ended_at (history is kept); it is never deleted casually.
// Partial unique indexes (added in the migration SQL) allow only one active
// membership per user per organization and one active president per organization.
model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole @default(MEMBER)
  title          String? // optional display title, e.g. "Vice President"
  semesterId     String?          @map("semester_id") @db.Uuid
  source         MembershipSource @default(ADMIN)
  semester       Semester?        @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  startedAt      DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime?        @map("ended_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([organizationId, role])
  @@map("organization_members")
}

// Invitation codes that let a signed-in user join an organization as MEMBER (never any other role).
// Only a SHA-256 hash of the code is stored; the raw code is shown once, at creation.
// The migration SQL adds: one non-revoked code per organization (partial unique index) and
// CHECK constraints on max_uses/use_count.
model OrganizationJoinCode {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  codeHash       String    @unique @map("code_hash")
  codeHint       String    @map("code_hint") // last 4 characters, to tell codes apart
  createdById    String?   @map("created_by_id") @db.Uuid
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  maxUses        Int?      @map("max_uses")
  useCount       Int       @default(0) @map("use_count")
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("organization_join_codes")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum ConsequenceStatus {
  PENDING
  COMPLETED
  WAIVED
  CANCELLED
}

enum ObligationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EvaluationStatus {
  DRAFT
  OPEN
  CLOSED
}

enum QuestionType {
  RATING
  TEXT
  CHOICE
  LIKERT
}

enum PaymentMethod {
  CASH
  GCASH
  BANK_TRANSFER
  OTHER
}

// Student profile data, kept apart from login credentials (users).
// PSGC codes are validated server-side against https://psgc.gitlab.io/api/ before saving;
// names are stored alongside the codes so records stay readable if PSGC data later changes.
model StudentProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  studentNumber String   @unique @map("student_number")
  middleName    String?  @map("middle_name")
  college       String?
  course        String?
  yearLevel     Int?     @map("year_level")
  programId     String?  @map("program_id") @db.Uuid
  rfidUid       String?  @unique @map("rfid_uid")
  photoKey      String?  @map("photo_key")
  program       Program? @relation(fields: [programId], references: [id], onDelete: Restrict)
  contactNumber String?  @map("contact_number")
  streetAddress String?  @map("street_address")
  regionCode    String?  @map("region_code")
  regionName    String?  @map("region_name")
  provinceCode  String?  @map("province_code")
  provinceName  String?  @map("province_name")
  cityCode      String?  @map("city_code")
  cityName      String?  @map("city_name")
  barangayCode  String?  @map("barangay_code")
  barangayName  String?  @map("barangay_name")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("student_profiles")
}

// One-time account setup links (hash only). Used after student import and by admin "setup link".
model ActivationToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("activation_tokens")
}

model SystemSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@map("system_settings")
}

model Event {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @map("organization_id") @db.Uuid
  title              String
  description        String?
  venue              String
  startsAt           DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime        @map("ends_at") @db.Timestamptz(3)
  attendanceOpensAt  DateTime        @map("attendance_opens_at") @db.Timestamptz(3)
  attendanceClosesAt DateTime        @map("attendance_closes_at") @db.Timestamptz(3)
  semesterId         String?         @map("semester_id") @db.Uuid
  targetMode         EventTargetMode @default(ALL_MEMBERS) @map("target_mode")
  requireEvaluation  Boolean         @default(false) @map("require_evaluation")
  semester           Semester?       @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  sessions           EventSession[]
  targets            EventTarget[]
  rules              EventRule[]
  assessments        StudentFee[]
  feeTypes           FeeType[]
  documents          Document[]
  status             EventStatus     @default(DRAFT)
  createdById        String?         @map("created_by_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Soft delete: a deleted event is hidden everywhere and can be restored. Only never-used drafts can be deleted.
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(3)
  deletedById        String?         @map("deleted_by_id") @db.Uuid
  restoredAt         DateTime?       @map("restored_at") @db.Timestamptz(3) // last restore, shown as "Restored"
  // Chosen by a System Admin to appear on the public landing page (published, not deleted events only).
  showOnLanding      Boolean         @default(false) @map("show_on_landing")
  images             EventImage[]

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  attendance   AttendanceRecord[]
  evaluation   EvaluationForm?
  consequences Consequence[]
  obligations  Obligation[]

  @@index([organizationId, startsAt])
  @@index([organizationId, deletedAt], map: "events_org_deleted_idx")
  @@map("events")
}

// Created only by the QR scan service, which validates event window, membership and scanner authority.
model AttendanceRecord {
  id           String           @id @default(uuid()) @db.Uuid
  eventId      String           @map("event_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  status       AttendanceStatus @default(PRESENT)
  scannedById  String?          @map("scanned_by_id") @db.Uuid
  scannedAt    DateTime         @default(now()) @map("scanned_at") @db.Timestamptz(3)
  sessionId    String           @map("session_id") @db.Uuid
  source       AttendanceSource @default(OFFICER_SCAN)
  remark       String?
  modifiedById String?          @map("modified_by_id") @db.Uuid
  modifiedAt   DateTime?        @map("modified_at") @db.Timestamptz(3)
  session      EventSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([sessionId, userId]) // duplicate attendance is rejected by the database too
  @@index([eventId])
  @@index([userId])
  @@map("attendance_records")
}

model Announcement {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  title          String
  body           String
  status         PublishStatus        @default(DRAFT)
  authorId       String?              @map("author_id") @db.Uuid
  publishedAt    DateTime?            @map("published_at") @db.Timestamptz(3)
  semesterId     String?              @map("semester_id") @db.Uuid
  targetMode     EventTargetMode      @default(ALL_MEMBERS) @map("target_mode")
  semester       Semester?            @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  targets        AnnouncementTarget[]
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?              @map("deleted_by_id") @db.Uuid
  restoredAt     DateTime?            @map("restored_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, publishedAt])
  @@index([organizationId, deletedAt], map: "announcements_org_deleted_idx")
  @@map("announcements")
}

// File metadata; bytes live on disk under STORAGE_DIR using the random storage_key as the filename.
model Document {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  title          String
  description    String?
  fileName       String           @map("file_name")
  mimeType       String           @map("mime_type")
  sizeBytes      Int              @map("size_bytes")
  storageKey     String           @unique @map("storage_key")
  uploadedById   String?          @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?          @map("deleted_by_id") @db.Uuid
  restoredAt     DateTime?        @map("restored_at") @db.Timestamptz(3)
  category       DocumentCategory @default(OTHER)
  semesterId     String?          @map("semester_id") @db.Uuid
  eventId        String?          @map("event_id") @db.Uuid
  semester       Semester?        @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  event          Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("documents")
}

model ConsequenceRule {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  description    String?
  active         Boolean      @default(true)
  trigger        RuleTrigger  @default(ABSENT)
  sessionKind    SessionKind? @map("session_kind") // null = any session
  wholeDay       Boolean      @default(false) @map("whole_day") // applies only when absent from every session of the event
  penaltyType    PenaltyType  @default(FINE) @map("penalty_type")
  fineAmount     Decimal?     @map("fine_amount") @db.Decimal(10, 2)
  serviceHours   Decimal?     @map("service_hours") @db.Decimal(5, 1)
  events         EventRule[]
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  consequences Consequence[]

  @@unique([organizationId, name])
  @@map("consequence_rules")
}

model Consequence {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  ruleId         String?           @map("rule_id") @db.Uuid
  eventId        String?           @map("event_id") @db.Uuid
  reason         String
  status         ConsequenceStatus @default(PENDING)
  sessionId      String?           @map("session_id") @db.Uuid
  kind           PenaltyType       @default(FINE)
  amount         Decimal?          @db.Decimal(10, 2)
  hours          Decimal?          @db.Decimal(5, 1)
  calculatedAt   DateTime?         @map("calculated_at") @db.Timestamptz(3)
  sourceRecordId String?           @map("source_record_id") @db.Uuid
  session        EventSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  assessment     StudentFee?
  note           String?
  createdById    String?           @map("created_by_id") @db.Uuid
  resolvedById   String?           @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?         @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  rule         ConsequenceRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  event        Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([userId])
  @@map("consequences")
}

/// A requirement assigned to a member by an authorized officer. Separate from attendance records and consequences:
/// nothing here is created from an absence, and completing or missing one never creates a consequence by itself.
model Obligation {
  id                     String           @id @default(uuid()) @db.Uuid
  organizationId         String           @map("organization_id") @db.Uuid
  userId                 String           @map("user_id") @db.Uuid
  eventId                String?          @map("event_id") @db.Uuid
  title                  String
  description            String?
  completionRequirements String?          @map("completion_requirements")
  dueAt                  DateTime?        @map("due_at") @db.Timestamptz(3)
  status                 ObligationStatus @default(PENDING)
  memberNote             String?          @map("member_note")
  submittedAt            DateTime?        @map("submitted_at") @db.Timestamptz(3)
  completionNote         String?          @map("completion_note")
  completedAt            DateTime?        @map("completed_at") @db.Timestamptz(3)
  completedById          String?          @map("completed_by_id") @db.Uuid
  createdById            String?          @map("created_by_id") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([userId, status])
  @@map("obligations")
}

model EvaluationForm {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  eventId        String           @unique @map("event_id") @db.Uuid
  title          String
  status         EvaluationStatus @default(DRAFT)
  createdById    String?          @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  event        Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)
  questions    EvaluationQuestion[]
  responses    EvaluationResponse[]

  @@index([organizationId])
  @@map("evaluation_forms")
}

model EvaluationQuestion {
  id       String       @id @default(uuid()) @db.Uuid
  formId   String       @map("form_id") @db.Uuid
  position Int
  prompt   String
  type     QuestionType
  options  Json? // string[] for CHOICE questions
  required Boolean      @default(true)

  form    EvaluationForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers EvaluationAnswer[]

  @@index([formId, position])
  @@map("evaluation_questions")
}

// The respondent id exists only to enforce one response per person; result screens show aggregates.
model EvaluationResponse {
  id          String   @id @default(uuid()) @db.Uuid
  formId      String   @map("form_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)

  form    EvaluationForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  answers EvaluationAnswer[]

  @@unique([formId, userId])
  @@map("evaluation_responses")
}

model EvaluationAnswer {
  id          String  @id @default(uuid()) @db.Uuid
  responseId  String  @map("response_id") @db.Uuid
  questionId  String  @map("question_id") @db.Uuid
  ratingValue Int?    @map("rating_value")
  textValue   String? @map("text_value")

  response EvaluationResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question EvaluationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@map("evaluation_answers")
}

model FeeType {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String
  description    String?
  amount         Decimal        @db.Decimal(10, 2)
  dueDate        DateTime?      @map("due_date") @db.Timestamptz(3)
  active         Boolean        @default(true)
  kind           AssessmentKind @default(DUES)
  semesterId     String?        @map("semester_id") @db.Uuid
  eventId        String?        @map("event_id") @db.Uuid
  semester       Semester?      @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  event          Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments  StudentFee[]

  @@unique([organizationId, name])
  @@map("fee_types")
}

model StudentFee {
  id             String             @id @default(uuid()) @db.Uuid
  feeTypeId      String?            @map("fee_type_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  amountDue      Decimal            @map("amount_due") @db.Decimal(10, 2)
  organizationId String             @map("organization_id") @db.Uuid
  title          String
  kind           AssessmentKind     @default(DUES)
  semesterId     String?            @map("semester_id") @db.Uuid
  eventId        String?            @map("event_id") @db.Uuid
  consequenceId  String?            @unique @map("consequence_id") @db.Uuid
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  semester       Semester?          @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  event          Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  consequence    Consequence?       @relation(fields: [consequenceId], references: [id], onDelete: Restrict)
  adjustments    LedgerAdjustment[]
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  feeType  FeeType?  @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@unique([feeTypeId, userId])
  @@index([userId])
  @@map("student_fees")
}

// Payments are never deleted; mistakes are voided with a reason so the history stays auditable.
model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  studentFeeId    String        @map("student_fee_id") @db.Uuid
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod
  reference       String?
  paidAt          DateTime      @default(now()) @map("paid_at") @db.Timestamptz(3)
  recordedById    String?       @map("recorded_by_id") @db.Uuid
  voidedAt        DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason      String?       @map("void_reason")
  receiptCode     String        @unique @map("receipt_code")
  status          PaymentStatus @default(CONFIRMED)
  proofKey        String?       @map("proof_key")
  proofMime       String?       @map("proof_mime")
  submittedById   String?       @map("submitted_by_id") @db.Uuid
  verifiedById    String?       @map("verified_by_id") @db.Uuid
  verifiedAt      DateTime?     @map("verified_at") @db.Timestamptz(3)
  rejectionReason String?       @map("rejection_reason")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Restrict)

  @@index([studentFeeId])
  @@map("payments")
}

// ---------------------------------------------------------------- Stage A: academic structure & membership

enum OrganizationScope {
  DEPARTMENTAL
  COLLEGE_WIDE
  UNIVERSITY_WIDE
  CO_CURRICULAR // interest-based; students join by request or code
}

enum MembershipSource {
  ADMIN
  JOIN_CODE
  JOIN_REQUEST
  AUTO_MAPPING
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Archive (active=false) instead of deleting so historical records keep their references.
model SchoolYear {
  id        String     @id @default(uuid()) @db.Uuid
  label     String     @unique // e.g. "2025-2026"
  startsOn  DateTime   @map("starts_on") @db.Date
  endsOn    DateTime   @map("ends_on") @db.Date
  active    Boolean    @default(false)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  semesters Semester[]

  @@map("school_years")
}

model Semester {
  id           String   @id @default(uuid()) @db.Uuid
  schoolYearId String   @map("school_year_id") @db.Uuid
  name         String // "1st Semester", "2nd Semester", "Summer"
  sequence     Int
  startsOn     DateTime @map("starts_on") @db.Date
  endsOn       DateTime @map("ends_on") @db.Date
  active       Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  schoolYear        SchoolYear           @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  members           OrganizationMember[]
  enrollments       StudentEnrollment[]
  events            Event[]
  assessments       StudentFee[]
  feeTypes          FeeType[]
  clearanceRequests ClearanceRequest[]
  announcements     Announcement[]
  documents         Document[]

  @@unique([schoolYearId, sequence])
  @@map("semesters")
}

model College {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  departments   Department[]
  organizations Organization[]
  staffProfiles StaffProfile[]

  @@map("colleges")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  collegeId String   @map("college_id") @db.Uuid
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  college       College        @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  programs      Program[]
  organizations Organization[]
  staffProfiles StaffProfile[]

  @@unique([collegeId, code])
  @@unique([collegeId, name])
  @@map("departments")
}

model Program {
  id           String   @id @default(uuid()) @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  code         String   @unique
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  department    Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  students      StudentProfile[]
  enrollments   StudentEnrollment[]
  organizations Organization[]

  @@unique([departmentId, name])
  @@map("programs")
}

// A student's program and year level in one semester, so history survives program or year changes.
model StudentEnrollment {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  semesterId String   @map("semester_id") @db.Uuid
  programId  String   @map("program_id") @db.Uuid
  yearLevel  Int      @map("year_level")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  program  Program  @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@unique([userId, semesterId])
  @@index([programId, semesterId])
  @@map("student_enrollments")
}

model JoinRequest {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  status         JoinRequestStatus @default(PENDING)
  message        String?
  decidedById    String?           @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?         @map("decided_at") @db.Timestamptz(3)
  decisionNote   String?           @map("decision_note")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("JoinRequestUser", fields: [userId], references: [id], onDelete: Restrict)
  decidedBy    User?        @relation("JoinRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([userId])
  @@map("join_requests")
}

// ---------------------------------------------------------------- Stage B: sessions, targets, devices

enum SessionKind {
  TIME_IN
  TIME_OUT
}

enum AttendanceSource {
  RFID
  QR_SELF // student scanned the event/session QR on their own phone
  OFFICER_SCAN // officer scanned a student ID / member QR
  MANUAL // officer selected the student (requires a remark)
  SYSTEM // marked Absent when the session was finalized
}

enum EventTargetMode {
  ALL_MEMBERS
  FILTERED
}

// An event has one or more attendance sessions (Morning Time-In, Afternoon Time-Out, ...).
model EventSession {
  id            String      @id @default(uuid()) @db.Uuid
  eventId       String      @map("event_id") @db.Uuid
  label         String
  kind          SessionKind @default(TIME_IN)
  position      Int
  opensAt       DateTime    @map("opens_at") @db.Timestamptz(3)
  startsAt      DateTime    @map("starts_at") @db.Timestamptz(3) // expected time; later than start + grace is Late
  closesAt      DateTime    @map("closes_at") @db.Timestamptz(3) // cut-off
  graceMinutes  Int         @default(15) @map("grace_minutes")
  qrEpoch       Int         @default(0) @map("qr_epoch") // bumping it revokes every check-in QR issued earlier
  active        Boolean     @default(false) // an officer has activated the scanner session
  finalizedAt   DateTime?   @map("finalized_at") @db.Timestamptz(3)
  finalizedById String?     @map("finalized_by_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendance   AttendanceRecord[]
  consequences Consequence[]

  @@unique([eventId, position])
  @@map("event_sessions")
}

// One row = all of its filled-in fields must match; an event with several rows targets the union.
model EventTarget {
  id           String  @id @default(uuid()) @db.Uuid
  eventId      String  @map("event_id") @db.Uuid
  collegeId    String? @map("college_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  programId    String? @map("program_id") @db.Uuid
  yearLevel    Int?    @map("year_level")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_targets")
}

// Hardware RFID terminals. Only a hash of the device key is stored; the key is shown once at creation.
model ScannerDevice {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  keyHash        String    @unique @map("key_hash")
  active         Boolean   @default(true)
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  enrollments  RfidEnrollment[]

  @@unique([organizationId, name])
  @@map("scanner_devices")
}

// "Tap to register": an administrator opens a short window on one terminal; the next card tapped there is assigned to the
// student instead of being recorded as attendance. Kept as history (who registered which card, on which device, when).
model RfidEnrollment {
  id          String    @id @default(uuid()) @db.Uuid
  deviceId    String    @map("device_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cardUid     String?   @map("card_uid")
  failure     String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  device ScannerDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  user   User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([deviceId, expiresAt])
  @@map("rfid_enrollments")
}

// ---------------------------------------------------------------- Stage C/D: consequences, ledger, clearance, communication

enum RuleTrigger {
  ABSENT
  LATE
}

enum PenaltyType {
  FINE
  SERVICE_HOURS
}

enum AssessmentKind {
  DUES
  SEMESTER_FEE
  EVENT_CONTRIBUTION
  SPECIAL
  FINE
}

enum AdjustmentType {
  WAIVER
  DISCOUNT
  CORRECTION
  CHARGE
  REFUND
}

enum PaymentStatus {
  CONFIRMED
  PENDING // digital payment submitted, awaiting an officer's verification
  REJECTED
}

enum ClearanceStatus {
  REQUESTED
  ELIGIBLE
  CLEARED
  REJECTED
}

enum SignoffDecision {
  APPROVED
  REJECTED
}

enum DocumentCategory {
  MINUTES
  ATTENDANCE_SHEET
  RESOLUTION
  EVENT_DOCUMENT
  OTHER
}

// Which consequence rules apply to which event ("applicable attendance and consequence rules").
model EventRule {
  eventId String @map("event_id") @db.Uuid
  ruleId  String @map("rule_id") @db.Uuid

  event Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rule  ConsequenceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([eventId, ruleId])
  @@map("event_rules")
}

// Signed corrections to the ledger. Financial history is never rewritten or deleted.
model LedgerAdjustment {
  id           String         @id @default(uuid()) @db.Uuid
  studentFeeId String         @map("student_fee_id") @db.Uuid
  type         AdjustmentType
  amount       Decimal        @db.Decimal(10, 2) // positive increases what is owed, negative reduces it
  reason       String
  createdById  String?        @map("created_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Restrict)

  @@index([studentFeeId])
  @@map("ledger_adjustments")
}

model ClearanceRequest {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  semesterId      String          @map("semester_id") @db.Uuid
  status          ClearanceStatus @default(REQUESTED)
  requestedAt     DateTime        @default(now()) @map("requested_at") @db.Timestamptz(3)
  eligibleAt      DateTime?       @map("eligible_at") @db.Timestamptz(3)
  issuedAt        DateTime?       @map("issued_at") @db.Timestamptz(3)
  certificateCode String?         @unique @map("certificate_code")

  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  semester     Semester           @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  signoffs     ClearanceSignoff[]

  @@unique([userId, organizationId, semesterId])
  @@index([organizationId, status])
  @@map("clearance_requests")
}

model ClearanceSignoff {
  id         String           @id @default(uuid()) @db.Uuid
  requestId  String           @map("request_id") @db.Uuid
  role       OrganizationRole // the position that signed (President, Adviser, ...)
  signedById String           @map("signed_by_id") @db.Uuid
  decision   SignoffDecision
  note       String?
  signedAt   DateTime         @default(now()) @map("signed_at") @db.Timestamptz(3)

  request  ClearanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  signedBy User             @relation(fields: [signedById], references: [id], onDelete: Restrict)

  @@unique([requestId, role])
  @@map("clearance_signoffs")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String
  title     String
  body      String?
  href      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AnnouncementTarget {
  id             String  @id @default(uuid()) @db.Uuid
  announcementId String  @map("announcement_id") @db.Uuid
  collegeId      String? @map("college_id") @db.Uuid
  departmentId   String? @map("department_id") @db.Uuid
  programId      String? @map("program_id") @db.Uuid
  yearLevel      Int?    @map("year_level")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@map("announcement_targets")
}

// Faculty / staff profile. Separate from login credentials (users) and from organization positions.
model StaffProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  employeeId    String   @unique @map("employee_id")
  middleName    String?  @map("middle_name")
  contactNumber String?  @map("contact_number")
  collegeId     String?  @map("college_id") @db.Uuid
  departmentId  String?  @map("department_id") @db.Uuid
  jobTitle      String?  @map("job_title")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  college    College?    @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@map("staff_profiles")
}

// Fixed-window request counters for abuse-prone endpoints (sign-in by IP and by email). Works across serverless instances.
model RateLimit {
  key         String   @id
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int      @default(0)

  @@map("rate_limits")
}

// ---------------------------------------------------------------- Organization funds: money spent and other money received

enum FundTransactionType {
  EXPENSE // money the organization spent
  INCOME // money received other than member fees (opening balance, donation, sponsorship, ...)
}

enum FundCategory {
  // expenses
  SUPPLIES
  EVENT_MATERIALS
  PRINTING
  TRANSPORTATION
  FOOD
  VENUE
  SERVICES
  // income
  OPENING_BALANCE
  DONATION
  SPONSORSHIP
  // either
  OTHER
}

enum FundTransactionStatus {
  PENDING // recorded, waiting for approval: does not affect the balance
  APPROVED // counts in the balance
  REJECTED // never counted
  CANCELLED // withdrawn by the recorder before a decision
  REVERSED // was approved, then reversed with a reason: no longer counted, history kept
}

// One row per expense or other-income record. The organization's balance is always derived from these rows plus
// confirmed fee payments; there is no stored balance to edit. Rows are never deleted.
model FundTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  type           FundTransactionType
  title          String
  amount         Decimal               @db.Decimal(12, 2)
  category       FundCategory
  occurredOn     DateTime              @map("occurred_on") @db.Date
  purpose        String
  notes          String?
  status         FundTransactionStatus @default(PENDING)
  // set by the form so a double-submitted request cannot create the same record twice
  requestId      String                @unique @map("request_id")
  receiptKey     String?               @map("receipt_key")
  receiptMime    String?               @map("receipt_mime")
  receiptName    String?               @map("receipt_name")
  recordedById   String                @map("recorded_by_id") @db.Uuid
  decidedById    String?               @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?             @map("decided_at") @db.Timestamptz(3)
  decisionReason String?               @map("decision_reason")
  reversedById   String?               @map("reversed_by_id") @db.Uuid
  reversedAt     DateTime?             @map("reversed_at") @db.Timestamptz(3)
  reversalReason String?               @map("reversal_reason")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recordedBy   User         @relation("FundRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  decidedBy    User?        @relation("FundDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, occurredOn])
  @@map("fund_transactions")
}

// Append-only financial history. The database itself refuses UPDATE and DELETE on this table (see the migration), so
// no application user, bug or admin page can rewrite it. Times come from the database clock.
model FinancialAuditEntry {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  amount         Decimal? @db.Decimal(12, 2)
  actorId        String?  @map("actor_id") @db.Uuid
  before         Json?
  after          Json?
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation("FinancialAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("financial_audit_entries")
}

// A person's profile picture, one per account, stored in the database so it survives redeployments (the server's own disk
// is temporary on the host). Uploads are decoded, re-encoded and resized on the server (512 x 512 WebP, metadata removed);
// replacing or removing a picture replaces or deletes this row, so nothing is left behind. `version` grows on every change
// so screens can request the new picture. Linked to the account only: RFID cards and attendance never reference it.
model ProfilePhoto {
  userId    String   @id @map("user_id") @db.Uuid
  content   Bytes
  mime      String
  width     Int
  height    Int
  byteSize  Int      @map("byte_size")
  version   Int      @default(1)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile_photos")
}

// ---------------------------------------------------------------- Public landing page

// Pictures of an event shown on the public landing page, managed by System Admin only. Stored in the database (like
// profile pictures) so they survive redeployments; every upload is decoded and re-encoded as WebP with metadata removed.
// Removing a picture soft-deletes it (deleted_at) so it can be restored.
model EventImage {
  id           String    @id @default(uuid()) @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  content      Bytes
  mime         String
  width        Int
  height       Int
  byteSize     Int       @map("byte_size")
  altText      String?   @map("alt_text")
  position     Int       @default(0)
  uploadedById String?   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById  String?   @map("deleted_by_id") @db.Uuid
  restoredAt   DateTime? @map("restored_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([eventId, deletedAt, position])
  @@map("event_images")
}

enum FeedbackStatus {
  PENDING // waiting for a System Admin (not public)
  APPROVED // shown on the landing page and counted in the average
  HIDDEN // refused or taken down by a System Admin
}

// A signed-in person's rating (1-5) and optional comment about Tapasok. One active entry per account (a partial unique
// index in the migration SQL ignores deleted rows); editing it sends it back for approval. Public display shows only the
// first name and last initial.
model SiteFeedback {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  rating        Int
  comment       String?
  status        FeedbackStatus @default(PENDING)
  moderatedById String?        @map("moderated_by_id") @db.Uuid
  moderatedAt   DateTime?      @map("moderated_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(3)
  deletedById   String?        @map("deleted_by_id") @db.Uuid
  restoredAt    DateTime?      @map("restored_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, deletedAt, updatedAt])
  @@map("site_feedback")
}
